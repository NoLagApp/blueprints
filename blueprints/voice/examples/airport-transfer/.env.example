# --- OpenRouter (one key drives STT, LLM, and TTS) ---
OPENROUTER_API_KEY=sk-or-...

# LLM that generates replies. Ministral is fast and cheap, good for voice latency.
# Alternatives: z-ai/glm-4.6, z-ai/glm-4.5-air, mistralai/ministral-3b-2512
LLM_MODEL=mistralai/ministral-8b-2512

# Speech-to-text model (OpenRouter /audio/transcriptions).
# Browse options: https://openrouter.ai/collections/speech-to-text-models
STT_MODEL=openai/gpt-4o-mini-transcribe
# Language hint for STT. Worth keeping set: handed a buffer of room noise, an
# unconstrained model will "transcribe" it as a phrase in some unrelated
# language and the agent will then reply in that language. Blank = auto-detect.
STT_LANGUAGE=en

# Text-to-speech model (OpenRouter /audio/speech) and voice. Must support
# response_format "pcm" (Mistral's voxtral TTS is mp3-only, so it won't work).
# What matters most for a phone call is how fast the FIRST byte arrives, since
# the agent forwards audio to the caller as it is produced. Aura sends audio in
# well under a second; hexgrad/kokoro-82m (voice af_heart) renders the whole
# clip first, so nothing plays for around 3 seconds, and
# google/gemini-3.1-flash-tts-preview (voice Kore) is slower still.
TTS_MODEL=deepgram/aura-2
TTS_VOICE=aura-2-thalia-en
# Sample rate of the raw PCM the TTS model returns (Aura, Kokoro and Gemini
# TTS all use 24000).
TTS_PCM_RATE=24000

# --- Voice activity detection ---
# The detector measures your background noise and requires speech to exceed it
# by NOISE_MULTIPLIER, so it adapts to the room on its own. SPEECH_RMS is only
# the absolute floor, used when the room is quieter than it.
# Agent triggering on background noise? Raise NOISE_MULTIPLIER (try 4 or 5).
# Agent not hearing you at all? Lower it (try 2), or lower SPEECH_RMS.
SPEECH_RMS=500
NOISE_MULTIPLIER=3
# Silence that ends your turn. Raise it if the agent cuts you off while you are
# still thinking mid-sentence; it is added directly to the reply delay.
SILENCE_HANG_MS=700
# Interrupting the agent: how long you must speak over it, and how much louder
# than the room you must be. The multiplier keeps the agent's own voice, leaking
# back through your speakers, from interrupting itself. If you cannot interrupt
# it, lower BARGE_IN_MULTIPLIER; if it stops for no reason, raise it.
BARGE_IN_MS=100
BARGE_IN_MULTIPLIER=1.5

# --- Filler speech ---
# Stalling phrases played while a turn is being generated, so the caller is not
# left in silence for several seconds. They are synthesised once at startup and
# cached, because rendering one on demand would add the very delay it hides.
# Separated by "|" so phrases can contain commas. Set to empty to disable.
# FILLER_PHRASES=Umm...|Let me think.|Let me have a look.|One moment.
# Wait this long for the real answer before playing a filler.
FILLER_DELAY_MS=500

# --- Agent behaviour ---
SYSTEM_PROMPT=You are Robin, a booking assistant for Northwind Transfers, a chauffeur and airport transfer company. You are on the phone with Alex, an existing client. You called them. Reason for the call: their airline moved their flight earlier, so their airport pickup probably needs to move too. The booking: a car collects Alex from home and takes them to the airport, today. Their flight was departing at 6:40 PM and now departs at 4:15 PM. Their pickup is currently booked for 3:40 PM, which is now far too late. You recommend moving the pickup to 1:15 PM, which allows for traffic and airport check-in. Your goal: make sure Alex knows about the flight change, then ask whether they want to move the pickup. Once they agree to a time, confirm it back to them once, say they will get a confirmation text, and then stop. Do not ask them to confirm the same time again, and do not re-open a decision they have already made. If they want a different time, accept it and confirm that time instead. You work in the office. You are not the driver and you will not be at the pickup or the airport, so never say you will see them, meet them, or be there. If they ask something you have not been told, such as which driver or which vehicle, say you will check and have the office confirm shortly. Never invent booking details, prices, driver names, or vehicles. Speak naturally, like a helpful person on the phone. Keep replies to one or two short sentences, since they are spoken aloud. Never use markdown or lists.
GREETING=Thanks for calling Northwind Transfers, this is Robin. How can I help?
# Spoken instead of GREETING when the agent places the call.
OUTBOUND_GREETING=Hi Alex, it's Robin, an AI assistant calling on behalf of Northwind Transfers. I'm just following up about a change to your booking today. Your flight's been moved earlier, so I wanted to check whether you'd like to bring your pickup forward.
# Outbound: hold the intro until the person answering has spoken, so Robin
# does not talk over their "hello". Set false to speak the moment they answer.
WAIT_FOR_HELLO=true

# --- Server ---
PORT=3000
# Public hostname Twilio can reach (e.g. your ngrok domain), no protocol, no
# trailing slash. Only needed for real phone calls; the browser simulator at
# http://localhost:3000/simulator works without it.
PUBLIC_HOST=your-subdomain.ngrok.app

# --- NoLag coordination layer (optional; the call works without it) ---
# Actor token used by the server for each call's connection.
NOLAG_ACCESS_TOKEN=at_...
NOLAG_URL=wss://broker.nolag.app/ws

# App slug of an app created from the Agents blueprint, so its schema has the
# topics this example uses (tasks, results, state, events, inbox, tools,
# approval). NoLag appends a random suffix to every app slug, so copy the real
# one from the dashboard: it will look like voice-calls-56c2, not voice-calls.
NOLAG_APP=voice-calls-1a2b

# Project API key. Required for coordination: each call gets its own room, and
# rooms must be created through the control plane before anything can use them.
# The app also needs config.autoProvisionRooms=true (see the README).
# Without this key the phone agent still works, it just coordinates nothing.
NOLAG_API_KEY=nlg_live_...
# Override only if you are not on production (e.g. https://api.dev.nolag.app/v1)
# NOLAG_API_URL=https://api.nolag.app/v1

# A SECOND actor token, used only by `npm run monitor`. This must be a
# different actor from NOLAG_ACCESS_TOKEN: the broker never delivers a message
# back to the actor that published it, so a monitor sharing the server's actor
# connects successfully and then shows you nothing.
NOLAG_MONITOR_TOKEN=at_...

# --- Twilio (only needed for real phone calls) ---
# From the Twilio console. TWILIO_NUMBER must be a number on your account,
# in E.164 format. Outbound calls also need a public PUBLIC_HOST above.
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_NUMBER=+61400000000
# Preferred over the auth token: revocable and scoped. Create under
# Console -> Account -> API keys & tokens. TWILIO_ACCOUNT_SID is still needed,
# because it identifies the account in the request URL.
TWILIO_API_KEY_SID=SK...
TWILIO_API_KEY_SECRET=...
# Set if your account is region-isolated (Australia=au1, Ireland=ie1).
# Regional credentials are rejected by the default api.twilio.com host.
TWILIO_REGION=

# --- Call screeners and voicemail ---
# Spoken to a screener that asks who is calling. Says who and why, and
# deliberately nothing about the booking: a screener is not the client.
IDENTIFY_MESSAGE=This is Robin, an AI assistant calling on behalf of Northwind Transfers, for Alex. It's about a change to their transport booking today.
# Left on voicemail, after which the call is ended.
VOICEMAIL_MESSAGE=Hi Alex, this is Robin, an AI assistant from Northwind Transfers. Your flight today has been moved earlier, to 4:15 PM, so your pickup at 3:40 PM is now too late. We'd suggest moving it to 1:15 PM. Please give us a call back to confirm, and we'll get that sorted. Thank you.
# Said when the caller signals the call is over, just before hanging up.
FAREWELL_MESSAGE=Thanks Alex, that's all sorted. Have a great flight, goodbye.

# --- Recording ---
# Per call: <callsid>-caller.wav, <callsid>-agent.wav, .jsonl and .txt.
# Recordings contain personal data and usually need everyone consent.
RECORD_CALLS=true
# RECORD_DIR=./recordings
